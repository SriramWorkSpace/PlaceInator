# ONNX models are downloaded at first run into the per-user data directory
# (see Settings.models_dir) -- deliberately NOT into the repo, so a packaged
# install and a dev checkout resolve them the same way.

# Node
node_modules/
dist-frontend/
.vite/

# Tauri
src-tauri/target/
src-tauri/binaries/

# App data / secrets
#
# M4 adds Google OAuth for Gmail/Calendar (ADR 0001); the refresh token is
# meant to live in the OS keychain, never a file, but these patterns are
# covered now, before that lands, rather than added after a token file
# almost gets committed once.
*.db
*.db-shm
*.db-wal
*.sqlite3
credentials.json
client_secret*.json
service-account*.json
token.json
*.token
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# OS
Thumbs.db
.DS_Store

# graphify knowledge-graph output (regenerated locally, not part of the source tree)
graphify-out/
